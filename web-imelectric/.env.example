# Google Analytics 4 — ID de medición (ej. G-XXXXXXXXXX)
# https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — ID del proyecto (cadena del snippet)
# https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# SMTP Hostinger — envío directo de formularios (API /api/contact)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@imelectric.es
# Configurar únicamente en el VPS; nunca guardar la contraseña real en Git.
SMTP_PASSWORD=
SMTP_FROM=contacto@imelectric.es
# Destino de leads y consultas.
CONTACT_TO_EMAIL=contacto@imelectric.es
